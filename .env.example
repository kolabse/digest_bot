TELEGRAM_BOT_TOKEN=replace-me
# Optional HTTP or SOCKS5 proxy, for example http://127.0.0.1:3128
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:1080
# Optional allowlist. Leave empty to allow any user (group setup still requires group admin rights).
# Example: BOT_ADMIN_USER_IDS=123456789,987654321
BOT_ADMIN_USER_IDS=
DEFAULT_TIMEZONE=Asia/Yekaterinburg
DATABASE_PATH=data/digest-bot.sqlite3
SCHEDULER_INTERVAL_SECONDS=30
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_RETRY_INITIAL_SECONDS=60
DELIVERY_RETRY_MAX_SECONDS=3600
DELIVERY_CLAIM_LEASE_SECONDS=3600

# Fine-grained token with read-only Contents access for private repositories.
GITHUB_TOKEN=github_pat_replace-me

# Comma-separated self-hosted GitLab instances accepted in /setup.
GITLAB_ALLOWED_HOSTS=gitlab.example.com
GITLAB_TOKEN=glpat_replace-me
